# Targeted line-ending rules only.  Deliberately NOT "* text=auto": the tree
# still contains legacy CRLF text files, and a global rule would flag them all
# for renormalization.  Add rules here as specific needs arise.

# Shell scripts: a CRLF checkout (Git for Windows default core.autocrlf=true)
# breaks the shebang.  (The build itself no longer runs any .sh —
# modify-generated-sources.sh was ported to ModifyGeneratedSources.java;
# see docs/developer/change-requests/CR-009-windows-builds.md.)
*.sh text eol=lf

# Golden fixtures compared byte-for-byte: GoldenOutputTest normalizes the
# ACTUAL diff output to LF but reads these expected files raw, so a CRLF
# checkout fails every comparison (and docx4j-diffx-tests is in the reactor,
# so that fails "mvn install").
docx4j-diffx-tests/src/test/resources/org/docx4j/diff/golden/** text eol=lf

# List numbering model: converted to LF in CR-014 phase 0 (55c5475e1); keep it so.
docx4j-core/src/main/java/org/docx4j/model/listnumbering/** text eol=lf
docx4j-core-tests/src/test/java/org/docx4j/model/listnumbering/*.java text eol=lf
docx4j-core-tests/src/test/java/org/docx4j/model/listnumbering/ind/** text eol=lf

# Property resolution: converted to LF in CR-015 phase 0 (6f4763d70); keep it so.
docx4j-core/src/main/java/org/docx4j/model/*.java text eol=lf
docx4j-core/src/main/java/org/docx4j/model/styles/** text eol=lf
docx4j-core-tests/src/test/java/org/docx4j/model/*.java text eol=lf
docx4j-core-tests/src/test/java/org/docx4j/model/styles/** text eol=lf
docx4j-core-tests/src/test/resources/org/docx4j/model/styles-simple.xml text eol=lf

# Font selection and mapping: converted to LF in CR-016 phase 0; keep it so.
docx4j-core/src/main/java/org/docx4j/fonts/*.java text eol=lf
docx4j-core/src/main/java/org/docx4j/fonts/substitutions/** text eol=lf
docx4j-core/src/main/java/org/docx4j/fonts/microsoft/** text eol=lf
docx4j-core-tests/src/test/java/org/docx4j/fonts/*.java text eol=lf
docx4j-core/src/main/resources/org/docx4j/fonts/substitutions/FontSubstitutions.xsd text eol=lf
docx4j-core/src/main/resources/org/docx4j/fonts/microsoft/MicrosoftFonts.xsd text eol=lf

