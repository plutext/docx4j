		  <groupId>ch.qos.logback</groupId>
		  <artifactId>logback-classic</artifactId>
		  <version>1.3.0-alpha4</version>
			<scope>test</scope>
		</dependency>

		<dependency>
            <groupId>org.docx4j</groupId>
            <artifactId>docx4j-samples-resources</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
	 -->
        
	</dependencies>
	
</project>
