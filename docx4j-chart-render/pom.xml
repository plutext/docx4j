<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.docx4j</groupId>
		<artifactId>docx4j-parent</artifactId>
		<version>${revision}</version>
	</parent>

	<artifactId>docx4j-chart-render</artifactId>
	<packaging>jar</packaging>
	<name>docx4j-chart-render</name>

	<description>
		Charts drawn as Office draws them (CR-037): a classic chart from docx4j's read model to
		Graphics2D, SVG (Batik's SVGGraphics2D) and PNG.  Provides docx4j-core's ChartRenderer;
		docx4j-export-fo depends on it, so PDF output draws charts.
	</description>

	<build>
		<sourceDirectory>src/main/java</sourceDirectory>
		<outputDirectory>bin</outputDirectory><!--  for a clean jar, be sure to avoid mixing mvn and eclipse output -->
	</build>

	<dependencies>

		<dependency>
			<groupId>org.docx4j</groupId>
			<artifactId>docx4j-core</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- Batik's SVGGraphics2D, which the chart is drawn onto for SVG (the version
		     docx4j-export-fo has; see its pom for the exclusions) -->
		<dependency>
			<groupId>org.apache.xmlgraphics</groupId>
			<artifactId>batik-svggen</artifactId>
			<version>1.19</version>
			<exclusions>
				<exclusion>
					<groupId>xml-apis</groupId>
					<artifactId>xml-apis</artifactId>
				</exclusion>
				<exclusion>
					<groupId>xml-apis</groupId>
					<artifactId>xml-apis-ext</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.apache.xmlgraphics</groupId>
			<artifactId>batik-dom</artifactId>
			<version>1.19</version>
			<exclusions>
				<exclusion>
					<groupId>xml-apis</groupId>
					<artifactId>xml-apis</artifactId>
				</exclusion>
				<exclusion>
					<groupId>xml-apis</groupId>
					<artifactId>xml-apis-ext</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>org.docx4j</groupId>
			<artifactId>docx4j-JAXB-ReferenceImpl</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- Carlito (Calibri's metrics) and Akasia (Aptos's), which the oracle's charts are measured in -->
		<dependency>
			<groupId>org.docx4j</groupId>
			<artifactId>docx4j-export-fo-fonts-crosextra</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.docx4j</groupId>
			<artifactId>docx4j-export-fo-fonts-theme2023</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<version>${version.logback-classic}</version>
			<scope>test</scope>
		</dependency>

	</dependencies>

</project>
