<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.docx4j</groupId>
		<artifactId>docx4j-parent</artifactId>
		<version>${revision}</version>
	</parent>
	<artifactId>docx4j-layout-fidelity</artifactId>
	<packaging>jar</packaging>
	<name>docx4j-layout-fidelity</name>
	<description>
		Word layout fidelity harness (CR-001 Phase 0): generates a corpus of probe
		documents, drives Word (via documents4j) to produce reference PDFs, renders
		the same corpus with docx4j+FOP, and compares the two at layout-dump and
		pixel level, producing an HTML report. Not in the reactor; not deployed.
	</description>
	<properties>
		<maven.deploy.skip>true</maven.deploy.skip>
		<!-- The FO renderer the harness scores with (CR-020 §3.3): Apache FOP 2.11 by default,
		     the docx4j FO renderer under -Pfo-renderer-fork.  The harness declares the renderer
		     itself (docx4j-export-fo's installed pom names Apache's, and a profile is not
		     transitive), and the profile copies the runtime jars to target/lib-fork instead of
		     target/lib, so both classpaths exist side by side and a batch is scored on each:
		         CP="target/classes:target/lib/*"        (Apache FOP)
		         CP="target/classes:target/lib-fork/*"   (the docx4j FO renderer)  -->
		<fo.renderer.groupId>org.apache.xmlgraphics</fo.renderer.groupId>
		<fo.renderer.artifactId>fop</fo.renderer.artifactId>
		<fo.renderer.events.artifactId>fop-events</fo.renderer.events.artifactId>
		<fo.renderer.version>2.11</fo.renderer.version>
		<fidelity.libDir>${project.build.directory}/lib</fidelity.libDir>
	</properties>
	<build>
		<plugins>
			<plugin>
				<groupId>org.sonatype.plugins</groupId>
				<artifactId>nexus-staging-maven-plugin</artifactId>
				<configuration>
					<skipNexusStagingDeployMojo>true</skipNexusStagingDeployMojo>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
			</plugin>
			<!-- copy the runtime dependencies to target/lib on every package, so the mains
			     run with the wildcard classpath "target/classes:target/lib/*" on any OS
			     (a classpath string in a file is too long for cmd's set /p). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-dependencies</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${fidelity.libDir}</outputDirectory>
							<includeScope>runtime</includeScope>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<dependencies>
		<dependency>
			<groupId>org.docx4j</groupId>
			<artifactId>docx4j-export-fo</artifactId>
			<version>${project.version}</version>
			<exclusions>
				<!-- the renderer is declared below, from the fo.renderer.* properties -->
				<exclusion>
					<groupId>org.apache.xmlgraphics</groupId>
					<artifactId>fop</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.xmlgraphics</groupId>
					<artifactId>fop-core</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.xmlgraphics</groupId>
					<artifactId>fop-events</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.xmlgraphics</groupId>
					<artifactId>fop-util</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- the FO renderer, with docx4j-export-fo's exclusions -->
		<dependency>
			<groupId>${fo.renderer.groupId}</groupId>
			<artifactId>${fo.renderer.artifactId}</artifactId>
			<version>${fo.renderer.version}</version>
			<exclusions>
				<exclusion>
					<groupId>commons-logging</groupId>
					<artifactId>commons-logging</artifactId>
				</exclusion>
				<exclusion>
					<groupId>xml-apis</groupId>
					<artifactId>xml-apis</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.xmlgraphics</groupId>
					<artifactId>batik-extension</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.xmlgraphics</groupId>
					<artifactId>batik-gvt</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>${fo.renderer.groupId}</groupId>
			<artifactId>${fo.renderer.events.artifactId}</artifactId>
			<version>${fo.renderer.version}</version>
			<exclusions>
				<exclusion>
					<groupId>com.thoughtworks.qdox</groupId>
					<artifactId>qdox</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- Word-style line breaking and line placement (CR-001 Phase 5) is part of
		     docx4j-export-fo and on by default; set
		     docx4j.convert.out.fo.wordLayout=false to measure without it -->
		<!-- a JAXB runtime, because the harness has runnable mains -->
		<dependency>
			<groupId>org.docx4j</groupId>
			<artifactId>docx4j-JAXB-ReferenceImpl</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- the Word golden runner (Windows only at runtime) -->
		<dependency>
			<groupId>org.docx4j</groupId>
			<artifactId>docx4j-documents4j-local</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Hyphenation patterns.  FOP ships none, and these are NOT under the Apache
		     licence (OFFO's fop-hyph is distributed under the LaTeX Project Public
		     Licence, plus the licences of the individual TeX pattern files), so this
		     is a dependency of this harness alone - which is not in the reactor and
		     never deployed - and of no published docx4j module.  Without it the
		     hyphenation probes render unhyphenated. -->
		<dependency>
			<groupId>net.sf.offo</groupId>
			<artifactId>fop-hyph</artifactId>
			<version>2.0</version>
		</dependency>
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.8</version>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>2.0.13</version>
		</dependency>
	</dependencies>

	<profiles>
		<!-- score with the docx4j FO renderer: jars to target/lib-fork (CR-020) -->
		<profile>
			<id>fo-renderer-fork</id>
			<properties>
				<fo.renderer.groupId>org.docx4j</fo.renderer.groupId>
				<fo.renderer.artifactId>docx4j-fo-renderer</fo.renderer.artifactId>
				<fo.renderer.events.artifactId>docx4j-fo-renderer-events</fo.renderer.events.artifactId>
				<fo.renderer.version>2.11-docx4j.1-SNAPSHOT</fo.renderer.version>
				<fidelity.libDir>${project.build.directory}/lib-fork</fidelity.libDir>
			</properties>
		</profile>
	</profiles>
</project>
