<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock"
	targetNamespace="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock"
	elementFormDefault="qualified" attributeFormDefault="qualified" blockDefault="#all"
	xmlns:w12="http://schemas.openxmlformats.org/wordprocessingml/2006/main"
	xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
	xmlns:xjc="https://jakarta.ee/xml/ns/jaxb/xjc"
	jaxb:version="3.0">

<!--
	[MS-DOCX] revision 23.0 (2026-08-18), section 5.9 "http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock Schema",
	https://learn.microsoft.com/en-us/openspecs/office_standards/ms-docx/14bc8126-7c6e-41a8-b042-c199036e2339
	Taken from the HTML section page on 2026-09-20 (CR-023 phase 1; docs/developer/adding-a-schema.md,
	"obtaining the schema"). The body below is the page's text apart from: the import schemaLocation mapped
	to this tree, the page's non-breaking spaces replaced, and the JAXB package annotation.
	An attribute-only schema: XJC generates no package for it; the attribute is a property of
	CT_SdtPr in org.docx4j.wml (wml.xsd references it).
-->

	<xsd:annotation>
		<xsd:appinfo>
			<xsd:appinfo>
				<jaxb:globalBindings>
				</jaxb:globalBindings>
			</xsd:appinfo>
			<jaxb:schemaBindings>
				<jaxb:package name="org.docx4j.w16sdtfl"/>
			</jaxb:schemaBindings>
		</xsd:appinfo>
	</xsd:annotation>

	<xsd:import id="w12" namespace="http://schemas.openxmlformats.org/wordprocessingml/2006/main" schemaLocation="wml.xsd"/>

	<xsd:attribute name="formattingAllowed" type="w12:ST_OnOff"/>

</xsd:schema>
