<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns="http://schemas.microsoft.com/office/spreadsheetml/2015/revision2"
	targetNamespace="http://schemas.microsoft.com/office/spreadsheetml/2015/revision2"
	elementFormDefault="qualified"
	xmlns:s="http://schemas.openxmlformats.org/officeDocument/2006/sharedTypes"
	xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
	xmlns:xjc="https://jakarta.ee/xml/ns/jaxb/xjc"
	jaxb:version="3.0">

<!--
	[MS-XLSX] revision 29.1 (2026-05-19), section 5.16 "http://schemas.microsoft.com/office/spreadsheetml/2015/revision2 Schema",
	https://learn.microsoft.com/en-us/openspecs/office_standards/ms-xlsx/7b729443-d0cd-434e-8d8c-b228f701a55b
	Taken from the HTML section page on 2026-09-20 (CR-022 phase 1; docs/developer/adding-a-schema.md,
	"obtaining the schema"). Re-take it from the same page; the body below is the page's text apart from:
	  - import schemaLocations mapped to this tree
	  - x:ST_Xstring and x:ST_Guid written s:ST_Xstring and s:ST_Guid (the main schema takes them from the shared types)
	  - the JAXB package annotation
-->

  <xsd:annotation>
    <xsd:appinfo>
      <xsd:appinfo>
        <jaxb:globalBindings>
        </jaxb:globalBindings>
      </xsd:appinfo>
      <jaxb:schemaBindings>
        <jaxb:package name="org.xlsx4j.com.microsoft.schemas.office.spreadsheetml.x2015.revision2"/>
      </jaxb:schemaBindings>
    </xsd:appinfo>
  </xsd:annotation>

  <xsd:import namespace="http://schemas.openxmlformats.org/officeDocument/2006/sharedTypes" schemaLocation="../shared/shared-commonSimpleTypes.xsd"/>

  <xsd:attribute name="uid" type="s:ST_Guid"/>

</xsd:schema>
