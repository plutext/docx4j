<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
	xmlns="http://schemas.microsoft.com/office/spreadsheetml/2016/revision9"
	targetNamespace="http://schemas.microsoft.com/office/spreadsheetml/2016/revision9"
	elementFormDefault="qualified"
	xmlns:s="http://schemas.openxmlformats.org/officeDocument/2006/sharedTypes"
	xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
	xmlns:xjc="https://jakarta.ee/xml/ns/jaxb/xjc"
	jaxb:version="3.0">

<!--
	[MS-XLSX] revision 29.1 (2026-05-19), section 5.13 "http://schemas.microsoft.com/office/spreadsheetml/2016/revision9 Schema",
	https://learn.microsoft.com/en-us/openspecs/office_standards/ms-xlsx/1df7cd78-d8bc-4ec4-8952-1b61beeaee76
	Taken from the HTML section page on 2026-09-25 (CR-027 phase 1; docs/developer/adding-a-schema.md,
	"obtaining the schema"). Re-take it from the same page; the body below is the page's text apart from:
	  - the import of x:ST_Guid from the main schema replaced by s:ST_Guid from the shared types (the same type;
	    avoids a circular import, as office_spreadsheetml_2015_revision2.xsd does)
	  - the JAXB package annotation
	Attribute-only: XJC generates no package for it; uid becomes a property of the host types which reference it
	(CT_TableStyle).
-->

  <xsd:annotation>
    <xsd:appinfo>
      <xsd:appinfo>
        <jaxb:globalBindings>
        </jaxb:globalBindings>
      </xsd:appinfo>
      <jaxb:schemaBindings>
        <jaxb:package name="org.xlsx4j.com.microsoft.schemas.office.spreadsheetml.x2016.revision9"/>
      </jaxb:schemaBindings>
    </xsd:appinfo>
  </xsd:annotation>

  <xsd:import namespace="http://schemas.openxmlformats.org/officeDocument/2006/sharedTypes" schemaLocation="../shared/shared-commonSimpleTypes.xsd"/>

  <xsd:attribute name="uid" type="s:ST_Guid"/>

</xsd:schema>
